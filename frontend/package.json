{
  "name": "@intern-detector/frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i src/style.css -o dist/output.css",
    "build:js": "esbuild src/app.ts --bundle --outfile=dist/app.js --format=esm --sourcemap",
    "build": "npm run build:css && npm run build:js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
