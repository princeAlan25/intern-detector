{
  "name": "intern-detector",
  "version": "1.0.0",
  "description": "Checks internship offers, scholarship links, and viral forwards for scam patterns with a trust score and clear reasons.",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "build:css": "@tailwindcss/cli -i ./src/client/style.css -o ./public/dist/output.css",
    "build": "npm run build:client && npm run build:css"
  },
  "keywords": [
    "scam-detector",
    "internship-verifier",
    "trust-score",
    "typescript",
    "tailwindcss"
  ],
  "author": "Prince alain loui",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
