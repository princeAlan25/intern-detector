{
  "name": "intern-detector",
  "version": "1.0.0",
  "description": "A browser extension or app that checks internship offers, scholarship links, and viral forwards for scam patterns, then gives a trust score with clear reasons.",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build:css": "tailwindcss -i src/client/style.css -o public/dist/output.css",
    "build:js": "esbuild src/client/app.ts --bundle --outfile=public/dist/app.js --format=esm --sourcemap",
    "build": "npm run build:css && npm run build:js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:openrouter": "tsx scripts/test-openrouter.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princeAlan25/intern-detector.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/princeAlan25/intern-detector/issues"
  },
  "homepage": "https://github.com/princeAlan25/intern-detector#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
