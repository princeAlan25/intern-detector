{
  "name": "intern-detector",
  "version": "1.0.0",
  "description": "A fake-real detector checking internship offers, scholarship links, and messages for scam patterns, providing a trust score with clear evidence.",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run start --workspace=backend",
    "dev": "npm run dev --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run build:css --workspace=frontend && npx serve frontend",
    "build": "npm run build --workspace=frontend",
    "test": "npm test --workspaces",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:openrouter": "tsx scripts/test-openrouter.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princeAlan25/intern-detector.git"
  },
  "keywords": [
    "scam-detector",
    "internship-scam",
    "trust-score",
    "ai",
    "heuristics",
    "openrouter"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
